  },
  "dependencies": {
    "@primeuix/themes": "^3.0.0",
    "axios": "^1.19.0",
    "pinia": "^4.0.2",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.11",
