# IMAP
MAILBRIDGE_IMAP_SERVER=imap.example.com
MAILBRIDGE_IMAP_PORT=993
MAILBRIDGE_IMAP_USER=support@example.com
MAILBRIDGE_IMAP_PASS=your-password
MAILBRIDGE_IMAP_TLS=true
MAILBRIDGE_IMAP_INBOX=INBOX
MAILBRIDGE_IMAP_ARCHIVE=Archive
MAILBRIDGE_IMAP_ERRORS=Errors
MAILBRIDGE_IMAP_SCAN_INTERVAL=30s

# SMTP
MAILBRIDGE_SMTP_SERVER=smtp.example.com
MAILBRIDGE_SMTP_PORT=587
MAILBRIDGE_SMTP_USER=support@example.com
MAILBRIDGE_SMTP_PASS=your-password
MAILBRIDGE_SMTP_FROM=support@example.com
MAILBRIDGE_SMTP_TLS=true

# AI
MAILBRIDGE_AI_ENABLED=false
MAILBRIDGE_AI_PROVIDER=ollama
MAILBRIDGE_AI_BASE_URL=http://localhost:11434
MAILBRIDGE_AI_MODEL=qwen3.8-74k:latest
# Системный промпт вынесен из Modelfile (решение v0.22 #16): одна модель в памяти
# для mailbridge и агента. Приоритет: AI_SYSTEM_PROMPT > AI_SYSTEM_FILE.
MAILBRIDGE_AI_SYSTEM_FILE=configs/email-assistant-v2.system.txt
MAILBRIDGE_AI_TEMPERATURE=0.1
MAILBRIDGE_AI_API_KEY=

# Webhook
MAILBRIDGE_LISTEN=:8080

# Storage
MAILBRIDGE_STORAGE_DRIVER=sqlite
MAILBRIDGE_STORAGE_DSN=data/mailbridge.db

# NLP
MAILBRIDGE_NLP_RULES_FILE=configs/rules.yml

# AI fallback-проект (шаг 15): куда ставить задачу, если AI/классификатор не определил проект или вернул неизвестный
MAILBRIDGE_DEFAULT_PROJECT=Входящие

# Logging
MAILBRIDGE_LOG_LEVEL=info
MAILBRIDGE_LOG_FORMAT=json

# Shutdown
MAILBRIDGE_SHUTDOWN_TIMEOUT=30s

# Attachments
MAILBRIDGE_ATTACHMENTS_DIR=data/attachments

# Auth (веб-интерфейс)
# Всегда задавать свои в production (дефолт admin/admin — небезопасно)
MAILBRIDGE_AUTH_USER=admin
MAILBRIDGE_AUTH_PASS=change-me-in-production
# Агент-юзер (ФАЗА 4): юзер существует, только если задан пароль;
# не задан — агента нет (login от hermes → 401)
MAILBRIDGE_AGENT_USER=hermes
MAILBRIDGE_AGENT_PASS=